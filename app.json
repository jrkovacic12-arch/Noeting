{
  "expo": {
    "name": "Noeting",
    "slug": "noeting",
    "version": "0.10.0",
    "orientation": "portrait",
    "icon": "./assets/brand/generated/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.noeting.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F7F2",
        "foregroundImage": "./assets/brand/generated/android-foreground.png",
        "monochromeImage": "./assets/brand/generated/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.noeting.app",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "versionCode": 17
    },
    "web": {
      "favicon": "./assets/brand/generated/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-sqlite",
      "expo-system-ui",
      "expo-notifications",
      "./plugins/with-clean-android-launch.cjs"
    ]
  }
}
